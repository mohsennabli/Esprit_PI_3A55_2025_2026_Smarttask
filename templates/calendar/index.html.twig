{% extends 'base.html.twig' %}

{% block title %}SmartTask - Calendrier{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">📅 Calendrier des tickets</h1>

        <div class="alert alert-info">
            <strong>📊 Statistiques :</strong> {{ ticketsCount }} ticket(s) au total
        </div>

        <!-- Navigation -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button class="btn btn-outline-secondary" id="prevMonthBtn">◀ Mois précédent</button>
                    <h3 id="monthYearLabel" class="mb-0">Mai 2026</h3>
                    <button class="btn btn-outline-secondary" id="nextMonthBtn">Mois suivant ▶</button>
                    <button class="btn btn-primary" id="todayBtn">📅 Aujourd'hui</button>
                </div>
            </div>
        </div>

        <!-- Calendrier -->
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered text-center mb-0" id="calendarTable">
                        <thead class="table-dark">
                        <tr>
                            <th>Lundi</th>
                            <th>Mardi</th>
                            <th>Mercredi</th>
                            <th>Jeudi</th>
                            <th>Vendredi</th>
                            <th>Samedi</th>
                            <th>Dimanche</th>
                        </tr>
                        </thead>
                        <tbody id="calendarBody">
                        <tr>
                            <td colspan="7" class="text-muted py-5">Chargement...</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const tickets = {{ tickets|json_encode|raw }};
        let currentDate = new Date();

        const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
            'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];

        function formatDate(year, month, day) {
            return year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        }

        function getTicketsForDate(year, month, day) {
            const targetDate = formatDate(year, month, day);
            return tickets.filter(t => t.dateCreation.substring(0, 10) === targetDate);
        }

        function getPriorityColor(priorite) {
            switch(priorite) {
                case 'low': return '#6c757d';
                case 'medium': return '#0d6efd';
                case 'high': return '#ffc107';
                case 'urgent': return '#dc3545';
                default: return '#6c757d';
            }
        }

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            let startOffset = firstDay.getDay() === 0 ? 6 : firstDay.getDay() - 1;

            document.getElementById('monthYearLabel').textContent = monthNames[month] + ' ' + year;

            const calendarBody = document.getElementById('calendarBody');
            calendarBody.innerHTML = '';

            let dayCount = 1;
            let row = document.createElement('tr');

            for (let i = 0; i < startOffset; i++) {
                const cell = document.createElement('td');
                cell.style.height = '120px';
                cell.style.backgroundColor = '#1f232a';
                row.appendChild(cell);
            }

            for (let i = startOffset; i < 7 && dayCount <= lastDay.getDate(); i++) {
                const cell = createDayCell(year, month, dayCount);
                row.appendChild(cell);
                dayCount++;
            }
            calendarBody.appendChild(row);

            while (dayCount <= lastDay.getDate()) {
                row = document.createElement('tr');
                for (let i = 0; i < 7 && dayCount <= lastDay.getDate(); i++) {
                    const cell = createDayCell(year, month, dayCount);
                    row.appendChild(cell);
                    dayCount++;
                }
                calendarBody.appendChild(row);
            }
        }

        function createDayCell(year, month, day) {
            const cell = document.createElement('td');
            cell.style.height = '120px';
            cell.style.verticalAlign = 'top';
            cell.style.padding = '5px';
            cell.style.backgroundColor = '#2f343e';

            const ticketsOfDay = getTicketsForDate(year, month, day);

            const dayNumber = document.createElement('div');
            dayNumber.style.fontWeight = 'bold';
            dayNumber.style.fontSize = '16px';
            dayNumber.style.marginBottom = '5px';

            const today = new Date();
            if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
                dayNumber.innerHTML = `<span style="background-color: #0d6efd; color: white; padding: 2px 10px; border-radius: 25px;">${day}</span>`;
            } else {
                dayNumber.textContent = day;
            }
            cell.appendChild(dayNumber);

            for (let ticket of ticketsOfDay.slice(0, 3)) {
                const ticketDiv = document.createElement('div');
                ticketDiv.style.backgroundColor = getPriorityColor(ticket.priorite);
                ticketDiv.style.color = 'white';
                ticketDiv.style.fontSize = '10px';
                ticketDiv.style.padding = '3px 5px';
                ticketDiv.style.margin = '2px 0';
                ticketDiv.style.borderRadius = '3px';
                ticketDiv.style.cursor = 'pointer';
                ticketDiv.textContent = ticket.titre;
                ticketDiv.onclick = () => window.location.href = '/ticket/' + ticket.id + '/edit';
                cell.appendChild(ticketDiv);
            }

            if (ticketsOfDay.length > 3) {
                const moreDiv = document.createElement('div');
                moreDiv.style.fontSize = '10px';
                moreDiv.style.color = '#9ca3af';
                moreDiv.style.fontStyle = 'italic';
                moreDiv.style.cursor = 'pointer';
                moreDiv.textContent = '+ ' + (ticketsOfDay.length - 3) + ' autre(s)';
                moreDiv.onclick = () => alert(ticketsOfDay.map(t => `📌 #${t.id} : ${t.titre}`).join('\n'));
                cell.appendChild(moreDiv);
            }

            return cell;
        }

        document.getElementById('prevMonthBtn').onclick = () => { currentDate.setMonth(currentDate.getMonth() - 1); renderCalendar(); };
        document.getElementById('nextMonthBtn').onclick = () => { currentDate.setMonth(currentDate.getMonth() + 1); renderCalendar(); };
        document.getElementById('todayBtn').onclick = () => { currentDate = new Date(); renderCalendar(); };

        renderCalendar();
    </script>
{% endblock %}
