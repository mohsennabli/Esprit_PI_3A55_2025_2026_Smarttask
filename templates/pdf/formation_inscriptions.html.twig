<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des inscriptions - {{ formation.titre }}</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; }
        h1, h2 { text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #444; padding: 6px; text-align: left; }
        th { background-color: #f0f0f0; }
    </style>
</head>
<body>
    <h1>Liste des inscriptions</h1>
    <h2>{{ formation.titre }}</h2>

    <table>
        <thead>
        <tr>
            <th>Utilisateur</th>
            <th>Email</th>
            <th>Date d'inscription</th>
            <th>Statut</th>
            <th>Progression</th>
        </tr>
        </thead>
        <tbody>
        {% for inscription in formation.inscriptions %}
            <tr>
                <td>{{ inscription.user.username ?? 'N/A' }}</td>
                <td>{{ inscription.user.email ?? 'N/A' }}</td>
                <td>{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                <td>{{ inscription.statut }}</td>
                <td>{{ inscription.progression }} %</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune inscription pour cette formation.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>

