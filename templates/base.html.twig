<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SmartTask - Gestion des tickets{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        /* ===== THEME SMARTTASK DARK SLATE ===== */

        /* Main background */
        body {
            background: linear-gradient(135deg, #1f232a, #171a1f);
            font-family: 'Segoe UI', 'Inter', 'Roboto', sans-serif;
            min-height: 100vh;
            color: #f3f4f6;
        }

        /* Navbar */
        .navbar-dark.bg-dark {
            background-color: #1f232a !important;
            border-bottom: 1px solid #3d4450;
        }

        .navbar-brand {
            color: #f3f4f6 !important;
            font-weight: bold;
        }

        .nav-link {
            color: #b9c0cb !important;
        }

        .nav-link:hover {
            color: #f3f4f6 !important;
        }

        /* Cards */
        .card {
            background-color: #2b3038;
            border-color: #3d4450;
            border-radius: 14px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        .card-header {
            background-color: #2f343e;
            border-bottom-color: #3d4450;
            color: #f3f4f6;
            font-weight: 600;
            border-radius: 14px 14px 0 0 !important;
        }

        /* Tables */
        .table {
            background-color: #2f343e;
            color: #e5e7eb;
        }

        .table thead th {
            background-color: #3f4652;
            color: #e5e7eb;
            border-bottom-color: #4b5563;
            font-weight: 600;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #313744;
        }

        .table-striped tbody tr:nth-of-type(even) {
            background-color: #2f343e;
        }

        .table td, .table th {
            border-color: #4b5563;
        }

        /* Buttons */
        .btn-primary {
            background-color: #4b5563;
            border-color: #4b5563;
            color: #f9fafb;
            font-weight: 500;
        }

        .btn-primary:hover {
            background-color: #6b7280;
            border-color: #6b7280;
        }

        .btn-secondary {
            background-color: #374151;
            border-color: #374151;
            color: #f9fafb;
        }

        .btn-secondary:hover {
            background-color: #4b5563;
            border-color: #4b5563;
        }

        .btn-danger {
            background-color: #7f1d1d;
            border-color: #7f1d1d;
        }

        .btn-danger:hover {
            background-color: #991b1b;
            border-color: #991b1b;
        }

        .btn-success {
            background-color: #15803d;
            border-color: #15803d;
        }

        .btn-success:hover {
            background-color: #166534;
            border-color: #166534;
        }

        .btn-outline-secondary {
            color: #b9c0cb;
            border-color: #4b5563;
        }

        .btn-outline-secondary:hover {
            background-color: #4b5563;
            color: #f9fafb;
        }

        /* Formulaires */
        .form-control, .form-select {
            background-color: #3a404b;
            border-color: #4b5563;
            color: #f3f4f6;
        }

        .form-control:focus, .form-select:focus {
            background-color: #3a404b;
            border-color: #6b7280;
            color: #f3f4f6;
            box-shadow: none;
        }

        .form-control::placeholder {
            color: #9ca3af;
        }

        .form-label {
            color: #e5e7eb;
            font-weight: 500;
        }

        /* Badges / Status */
        .badge.bg-warning {
            background-color: #f59e0b !important;
            color: #1f232a;
        }

        .badge.bg-info {
            background-color: #0ea5e9 !important;
        }

        .badge.bg-success {
            background-color: #15803d !important;
        }

        .badge.bg-danger {
            background-color: #b91c1c !important;
        }

        .badge.bg-secondary {
            background-color: #4b5563 !important;
        }

        .badge.bg-primary {
            background-color: #3b82f6 !important;
        }

        /* Alertes */
        .alert-success {
            background-color: #15803d;
            border-color: #15803d;
            color: #f9fafb;
        }

        .alert-danger {
            background-color: #b91c1c;
            border-color: #b91c1c;
            color: #f9fafb;
        }

        /* Titres */
        h1, h2, h3, h4, h5, h6 {
            color: #f3f4f6;
        }

        .text-muted {
            color: #b9c0cb !important;
        }

        /* Calendrier */
        #calendarTable {
            background-color: #2f343e;
        }

        #calendarTable td, #calendarTable th {
            border-color: #4b5563;
        }

        /* Chat messages */
        .bg-light {
            background-color: #3a404b !important;
            color: #f3f4f6 !important;
        }

        /* Pagination */
        .pagination .page-link {
            background-color: #374151;
            border-color: #4b5563;
            color: #b9c0cb;
        }

        .pagination .page-link:hover {
            background-color: #4b5563;
            color: #f9fafb;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('ticket_index') }}">🎫 SmartTask</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="{{ path('ticket_index') }}">🎫 Tickets</a>
            <a class="nav-link" href="{{ path('statistiques_index') }}">📊 Statistiques</a>
            <a class="nav-link" href="{{ path('chatbot_index') }}">🤖 Assistant</a>
            <a class="nav-link" href="{{ path('calendar_index') }}">📅 Calendrier</a>
        </div>
    </div>
</nav>

<main class="container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
