{% extends 'base.html.twig' %}

{% block title %}SmartTask - Statistiques{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">📊 Tableau de bord statistique</h1>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Total Tickets</h5>
                        <h2 class="text-white">{{ total }}</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Taux résolution</h5>
                        <h2 class="text-white">{{ tauxResolution }}%</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Ouverts</h5>
                        <h2 class="text-warning">{{ stats.open|default(0) }}</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Résolus</h5>
                        <h2 class="text-success">{{ stats.resolved|default(0) }}</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">📈 Répartition par statut</div>
                    <div class="card-body">
                        <canvas id="statutChart" height="250"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">📊 Répartition par priorité</div>
                    <div class="card-body">
                        <canvas id="prioriteChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">📋 Détail des statuts</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p>🟡 Tickets ouverts : <strong>{{ stats.open|default(0) }}</strong></p>
                        <p>🔄 Tickets en cours : <strong>{{ stats.in_progress|default(0) }}</strong></p>
                    </div>
                    <div class="col-md-6">
                        <p>✅ Tickets résolus : <strong>{{ stats.resolved|default(0) }}</strong></p>
                        <p>🔘 Tickets fermés : <strong>{{ stats.closed|default(0) }}</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('statutChart'), {
            type: 'pie',
            data: {
                labels: ['Ouvert', 'En cours', 'Résolu', 'Fermé'],
                datasets: [{
                    data: [{{ stats.open|default(0) }}, {{ stats.in_progress|default(0) }}, {{ stats.resolved|default(0) }}, {{ stats.closed|default(0) }}],
                    backgroundColor: ['#f59e0b', '#0ea5e9', '#15803d', '#6c757d']
                }]
            }
        });

        new Chart(document.getElementById('prioriteChart'), {
            type: 'bar',
            data: {
                labels: ['Basse', 'Moyenne', 'Haute', 'Urgente'],
                datasets: [{
                    label: 'Nombre de tickets',
                    data: [{{ priorites.low|default(0) }}, {{ priorites.medium|default(0) }}, {{ priorites.high|default(0) }}, {{ priorites.urgent|default(0) }}],
                    backgroundColor: ['#6c757d', '#0d6efd', '#ffc107', '#dc3545']
                }]
            }
        });
    </script>
{% endblock %}
