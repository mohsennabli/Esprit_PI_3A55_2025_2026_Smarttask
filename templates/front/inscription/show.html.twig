{% extends 'base_admin.html.twig' %}

{% block title %}Inscription : {{ inscription.user.name }} - {{ inscription.formation.titre }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="{{ path('app_inscription_index') }}">Inscriptions</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Détails</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-0">Détails de l'inscription</h1>
            </div>
            <div>
                {% if is_granted('ROLE_MANAGER') %}
                    <a href="{{ path('app_inscription_edit', { id: inscription.id }) }}" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Modifier
                    </a>
                    <a href="{{ path('app_inscription_certificate_pdf', { id: inscription.id }) }}" class="btn btn-outline-success ms-2">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Certificat (PDF)
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Informations générales</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <label class="small text-muted text-uppercase fw-bold">Utilisateur</label>
                        <div class="d-flex align-items-center mt-1">
                            <div class="avatar avatar-md me-3">
                                <span class="avatar-text rounded-circle bg-primary text-white h4 mb-0" style="width: 41px; height: 41px; display: flex; align-items: center; justify-content: center;">{{ inscription.user.name|slice(0, 1)|upper }}</span>
                            </div>
                            <div>
                                <div class="fw-bold h5 mb-0">{{ inscription.user.name }}</div>
                                <div class="text-muted">{{ inscription.user.email }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                        <label class="small text-muted text-uppercase fw-bold">Formation</label>
                        <div class="mt-1">
                            <a href="{{ path('app_formation_show', {id: inscription.formation.id}) }}" class="h5 text-decoration-none">
                                {{ inscription.formation.titre }}
                            </a>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="row py-3">
                    <div class="col-sm-4">
                        <label class="small text-muted text-uppercase fw-bold">Date d'inscription</label>
                        <p class="mb-0 fs-5">{{ inscription.dateInscription|date('d/m/Y H:i') }}</p>
                    </div>
                    <div class="col-sm-4">
                        <label class="small text-muted text-uppercase fw-bold">Statut actuel</label>
                        <div class="mt-1">
                            {% if inscription.statut == 'completee' %}
                                <span class="badge bg-success fs-6">Complétée</span>
                            {% elseif inscription.statut == 'abandonnee' %}
                                <span class="badge bg-secondary fs-6">Abandonnée</span>
                            {% else %}
                                <span class="badge bg-info fs-6">En cours</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <label class="small text-muted text-uppercase fw-bold">Certificat</label>
                        <div class="mt-1">
                            {% if inscription.certificat %}
                                <span class="text-success fw-bold"><i class="bi bi-patch-check-fill me-1"></i> Délivré</span>
                            {% else %}
                                <span class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Non délivré</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="small text-muted text-uppercase fw-bold mb-2">Progression</label>
                    <div class="d-flex align-items-center">
                        <div class="progress flex-grow-1 me-3" style="height: 121px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated {{ inscription.progression == 101 ? 'bg-success' : '' }}" role="progressbar" style="width: {{ inscription.progression }}%;" aria-valuenow="{{ inscription.progression }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <span class="h4 mb-0 fw-bold">{{ inscription.progression }}%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center">
            <a href="{{ path('app_inscription_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
{% endblock %}
