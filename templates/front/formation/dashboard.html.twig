{% extends 'base_admin.html.twig' %}

{% block title %}Tableau de bord Formations & Inscriptions{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="{{ path('app_formation_index') }}">Formations</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tableau de bord</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0">Tableau de bord – Formations & Inscriptions</h1>
        <p class="text-muted small">Vue d’ensemble et indicateurs clés</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                    <i class="bi bi-journal-bookmark-fill text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total formations</div>
                    <div class="h4 mb-0">{{ total_formations }}</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 rounded-3 bg-success bg-opacity-10 p-3 me-3">
                    <i class="bi bi-people-fill text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total inscriptions</div>
                    <div class="h4 mb-0">{{ total_inscriptions }}</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 rounded-3 bg-info bg-opacity-10 p-3 me-3">
                    <i class="bi bi-graph-up-arrow text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Taux de complétion</div>
                    <div class="h4 mb-0">{{ completion_rate }}%</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 py-3">
                <h5 class="card-title mb-0">Formation la plus demandée</h5>
            </div>
            <div class="card-body">
                {% if most_popular_formation %}
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <a href="{{ path('app_formation_show', { id: most_popular_formation.id }) }}" class="fw-semibold text-decoration-none">
                                {{ most_popular_formation.titre }}
                            </a>
                            <div class="text-muted small mt-1">
                                {{ most_popular_formation.inscriptions|length }} inscription(s)
                            </div>
                        </div>
                        <i class="bi bi-trophy-fill text-warning fs-4"></i>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">Aucune formation ou inscription pour le moment.</p>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 py-3">
                <h5 class="card-title mb-0">Formations à venir (7 prochains jours)</h5>
            </div>
            <div class="card-body">
                {% if upcoming_this_week is not empty %}
                    <ul class="list-group list-group-flush">
                        {% for f in upcoming_this_week %}
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <a href="{{ path('app_formation_show', { id: f.id }) }}" class="text-decoration-none">
                                    {{ f.titre }}
                                </a>
                                <span class="badge bg-primary">{{ f.dateDebut|date('d/m/Y') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted mb-0">Aucune formation prévue cette semaine.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
