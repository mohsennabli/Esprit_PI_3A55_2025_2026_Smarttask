<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="350.0" minWidth="400.0" prefHeight="350.0" prefWidth="400.0"
            style="-fx-background-color: #f5f7fb;" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarttask.controller.LoginController">
    <children>
        <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="SmartTask"/>
            <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Sign in to your account"/>
            <TextField fx:id="emailField" maxWidth="260.0" promptText="Email"/>
            <PasswordField fx:id="passwordField" maxWidth="260.0" promptText="Password"/>
            <Button fx:id="loginButton" maxWidth="260.0" onAction="#handleLogin" text="Login"/>
            <Hyperlink fx:id="registerLink" onAction="#handleRegisterLink" text="Don't have an account? Register"/>
        </VBox>
    </children>
</AnchorPane>

